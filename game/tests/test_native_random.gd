extends SceneTree

const NativeRandom = preload("res://features/battle/native_random.gd")


func _initialize() -> void:
	# Values generated by java.util.Random(0), and the original h.a(-4, 5).
	var expected: Array[int] = [
		-1155484576,
		-723955400,
		1033096058,
		-1690734402,
		-1557280266,
		1327362106,
		-1930858313,
		502539523,
		-1728529858,
		-938301587,
		1431162155,
		1085665355,
		1654374947,
		-1661998771,
		-65105105,
		-73789608
	]
	var ranges: Array[int] = [2, -4, 4, -2, 2, 2, -1, -1, 4, 3, 1, 1, 3, -3, 1, 4]
	var raw: RefCounted = NativeRandom.new(0)
	var bounded: RefCounted = NativeRandom.new(0)
	for index: int in range(expected.size()):
		if raw.next_int() != expected[index] or bounded.native_range(-4, 5) != ranges[index]:
			push_error("Original random sequence mismatch at %d" % index)
			quit(1)
			return
	var minimum: RefCounted = NativeRandom.new(247775869193412)
	if minimum.native_range(-4, 5) != -12:
		push_error("Java Integer.MIN_VALUE overflow behavior differs")
		quit(1)
		return
	print("PASS: original Java random sequence and bounded draws")
	quit(0)
